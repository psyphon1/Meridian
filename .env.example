# =============================================================================
# Meridian — Autonomous AI PR Reviewer
# Environment contract (docs/SETUP.md §2). Copy to .env and fill in.
# NEVER commit .env or any real secret. 12-factor: config lives in env, not code.
# Variable names match the setup docs exactly — any change must be mirrored there.
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
APP_ENV=development            # development | staging | production

# ---- GitHub App (repo access + webhooks) — see docs/SETUP.md §2 & SECURITY.md §5
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=            # PEM private key contents (or path to it)
GITHUB_WEBHOOK_SECRET=         # high-entropy, HMAC-signed webhook secret (rotatable)

# ---- GitHub OAuth App (dashboard sign-in only; identity/session, not repo access)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---- Data stores -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0

# ---- BYOK model gateway (LiteLLM). User keys are injected per-request at runtime;
# these are only fallback defaults and SHOULD be empty in multi-tenant contexts.
MODEL_PROVIDER=                # e.g. openai | anthropic
MODEL_NAME=                    # e.g. gpt-4o | claude-sonnet-4
MODEL_DAILY_TOKEN_CEILING=     # per-tenant daily token ceiling (cost guardrail)

# ---- Secrets management (SECURITY.md §2 — envelope encryption of BYOK keys) --
KMS_MASTER_KEY=                # local dev: env-based master key (KMS/KEK)
SECRET_MANAGER_ENDPOINT=       # Vault/cloud KMS endpoint (used when not local)

# ---- Observability (OBSERVABILITY.md §3 — redact code/keys before export) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Sandbox execution (SECURITY.md §3) ------------------------------------
SANDBOX_EGRESS_ALLOWLIST=      # explicit registry allowlist, deny-all otherwise
SANDBOX_WALL_CLOCK_LIMIT_S=300


# Meridian environment contract (from Meridian_Design_Doc_Final.html — Setup section)
# Copy to .env and fill in. NEVER commit .env.

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Data stores
DATABASE_URL=
REDIS_URL=

# BYOK model gateway defaults (user keys are injected per-request at runtime)
MODEL_PROVIDER=
MODEL_NAME=

# Secrets management (KMS / Vault)
SECRET_MANAGER_ENDPOINT=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

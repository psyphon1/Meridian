{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian — Autonomous AI PR Reviewer: your autonomous first-pass senior engineer for every GitHub pull request.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web:dev": "pnpm --filter @meridian/web dev",
    "web:build": "pnpm --filter @meridian/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0"
  }
}

